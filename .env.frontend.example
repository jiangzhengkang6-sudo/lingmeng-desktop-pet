# Browser-facing settings only. Never put provider API keys in this file.
VITE_SPEECH_GATEWAY_URL=http://127.0.0.1:8000
VITE_SPEECH_MODEL=speech-2.8-hd
VITE_SPEECH_ENABLED=false
VITE_PET_EVENT_GATEWAY_URL=http://127.0.0.1:8000
VITE_PET_EVENT_ENABLED=true
VITE_AGENT_GATEWAY_URL=http://127.0.0.1:8000
VITE_AGENT_ENABLED=true
VITE_AGENT_TIMEOUT_MS=35000
VITE_IDENTITY_TIMEOUT_MS=35000
VITE_RTC_ROOM_ID=desktop-pet-identity
VITE_RTC_AGENT_USER_ID=desktop-pet-agent
VITE_RTC_TARGET_USER_IDS=desktop-owner
VITE_RAG_GATEWAY_URL=http://127.0.0.1:8000
VITE_RAG_ENABLED=true
# The browser talks only to the local gateway; provider keys stay in .env.
