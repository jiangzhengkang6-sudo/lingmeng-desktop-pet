# Server-side speech provider settings. Keep real secrets out of frontend code.
SPEECH_PROVIDER=minimax
SPEECH_MODEL=speech-2.8-hd
SPEECH_API_BASE_URL=https://api.minimax.io/v1
SPEECH_API_KEY=
SPEECH_TTS_ENDPOINT=
SPEECH_ASR_ENDPOINT=
SPEECH_VOICE_ID=
SPEECH_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://tauri.localhost,https://tauri.localhost

# 身份门禁总开关。false（默认/生产）= 必须通过人脸验证才解锁私有记忆与受控工具。
# 仅本地开发调试时可临时设为 true，绕过身份验证。
DESKTOP_PET_TEMP_OPEN_ACCESS=false

# 人脸识别（YuNet 检测 + SFace 身份嵌入，完全离线）。
# 模型默认从 gateway 同目录 models/ 加载，一般无需配置下面两项路径。
FACE_RECOGNITION_ENABLED=true
FACE_RECOGNITION_SIMILARITY_THRESHOLD=0.45
FACE_RECOGNITION_MIN_SAMPLES=3

# Server-side text Agent settings. Use mock until a Qwen/OpenAI-compatible endpoint is ready.
AGENT_PROVIDER=mock
AGENT_MODEL=qwen3.8-flash
AGENT_API_BASE_URL=
AGENT_API_KEY=
AGENT_CHAT_ENDPOINT=
AGENT_TIMEOUT_SECONDS=30
AGENT_FALLBACK_TO_MOCK=true
# Set true for final remote-agent acceptance. It rejects mock mode, incomplete
# remote settings, and silent fallback instead of masking them.
AGENT_REQUIRE_REMOTE=false
AGENT_CONTEXT_TURN_LIMIT=6
# Agent 编排引擎：legacy 使用原有顺序代码；langgraph 使用渐进迁移后的状态图。
# 迁移期间默认 legacy，只有显式切换为 langgraph 才走新工作流。
AGENT_WORKFLOW_ENGINE=legacy
# 预留影子模式配置：后续用于比对新旧链路，不在第一阶段改变用户可见响应。
AGENT_WORKFLOW_SHADOW=false
# LangGraph 检查点：默认 false 使用内存检查点；确认本地数据目录和隐私边界后
# 可设为 true，将图状态写入 SQLite，用于网关重启后的恢复。
LANGGRAPH_CHECKPOINT_ENABLED=false
# 默认使用桌面数据目录，也可显式指定检查点数据库路径。
# LANGGRAPH_CHECKPOINT_PATH=
# open_file 审批中断：默认 false，仍使用原有审批接口；设为 true 后，open_file
# 通过 LangGraph interrupt 暂停并在人工确认后恢复。该开关独立于 AGENT_WORKFLOW_ENGINE。
LANGGRAPH_APPROVAL_INTERRUPT_ENABLED=false

# Local user-confirmed memory. This SQLite database remains on this device and
# is not a Milvus replacement or a copy of conversation history. Leave the
# database paths blank to use the desktop runtime's local data directory.
# MEMORY_DATABASE_PATH=
MEMORY_CONTEXT_LIMIT=12

# Local reminders, display preferences, and private event logs. This is local
# structured state only; it is not a Milvus replacement.
# LOCAL_STATE_DATABASE_PATH=

# Controlled desktop tools. Keep allowlists empty until reviewed.
# Multiple entries use ";" on Windows and ":" on Linux/macOS.
# TOOLS_DATABASE_PATH=
TOOLS_ALLOWED_DIRECTORIES=
# 示例：TOOLS_ALLOWED_APPLICATIONS=记事本=notepad.exe
TOOLS_ALLOWED_APPLICATIONS=

# RAG 存储：迁移期默认保留 Milvus；设置为 sqlite-vec 后使用独立本地知识库文件。
# sqlite-vec 的元数据和向量保存在 RAG_SQLITE_PATH，不会混入 desktop-pet.sqlite3。
RAG_STORE=milvus
RAG_MILVUS_URI=http://127.0.0.1:19530
# RAG_SQLITE_PATH=
RAG_TIMEOUT_SECONDS=10
# 本地 hash 向量仅用于离线冒烟测试；正式语义检索请配置 OpenAI 兼容 embedding 服务。
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=local-hash-v1
RAG_EMBEDDING_DIMENSION=384
RAG_EMBEDDING_API_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_ENDPOINT=
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_MAX_UPLOAD_BYTES=5242880

# Doubao SAUC streaming ASR. Use either DOUBAO_API_KEY or the legacy key pair.
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
DOUBAO_API_KEY=
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
DOUBAO_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_UID=desktop_pet
DOUBAO_SEGMENT_DURATION_MS=200

# Voiceprint identity. Leave this at mock until a provider's official enrollment
# and verification API has been reviewed and implemented server-side.
VOICEPRINT_PROVIDER=mock
VOICEPRINT_MAX_AUDIO_BYTES=5242880

# Volcengine RTC voiceprint is emitted inside an AI-interaction task, rather
# than through the Doubao ASR API. To enable its trusted local bridge, set
# VOICEPRINT_PROVIDER=volcengine-rtc and fill all values below in .env only.
# VOICEPRINT_RTC_OWNER_NAME must exactly match RTC RegisterVoicePrint AudioName.
# RTC voiceprint recognition scores use the range [1, 100]. Start at 50 and
# tune only after observing real RTC results.
VOICEPRINT_RTC_OWNER_NAME=
VOICEPRINT_RTC_SCORE_THRESHOLD=50
VOICEPRINT_RTC_BRIDGE_SECRET=
VOICEPRINT_RTC_CLOCK_SKEW_SECONDS=300

# 官方 RTS 服务端回调配置：必须使用公网可访问的 HTTPS 地址。
# live 验收时建议由 Cloudflare Tunnel 临时映射到本地 FastAPI：
# https://<tunnel-domain>/api/identity/rtc/rts/messages
# 该密钥与本地 HMAC 桥接密钥分开，不能复用 AK/SK 或 API Key。
VOICEPRINT_RTC_CALLBACK_URL=
VOICEPRINT_RTC_CALLBACK_SECRET=

# RTC OpenAPI is used only by the local backend to start/stop VoiceChat tasks.
# Keep these values in .env; do not put them in a scene JSON or frontend env.
VOICEPRINT_RTC_ACCESS_KEY_ID=
VOICEPRINT_RTC_SECRET_ACCESS_KEY=
VOICEPRINT_RTC_APP_ID=
# RTC Web SDK 动态 Token 生成所需的 AppKey，仅服务端读取，禁止放入前端环境变量。
VOICEPRINT_RTC_APP_KEY=
VOICEPRINT_RTC_REGION=cn-north-1
VOICEPRINT_RTC_API_VERSION=2025-06-01
VOICEPRINT_RTC_SCENE_PATH=backend/config/voiceprint-rtc-scene.json
VOICEPRINT_RTC_TIMEOUT_SECONDS=15
# Local in-memory lifetime for a started RTC task. Stopped or expired tasks
# cannot submit voiceprint observations.
VOICEPRINT_RTC_SESSION_TTL_SECONDS=3600

